# Copy to backend/.env and fill in. Every value is read by app/config.py.

# Model server: any OpenAI-compatible endpoint. Default setup = Ollama on a GPU server,
# reached through the SSH tunnel in scripts/tunnel.ps1 (localhost:11435 -> server:11434).
LLM_BASE_URL=http://localhost:11435/v1
LLM_MODEL=hf.co/Qwen/Qwen3-14B-GGUF:Q4_K_M
EMBED_BASE_URL=http://localhost:11435/v1
EMBED_MODEL=hf.co/gpustack/bge-m3-GGUF:Q8_0

# SSH alias (from ~/.ssh/config) of the machine running Ollama
GPU_SSH_HOST=my-gpu-server

# Project PostgreSQL started by scripts/db.ps1
DATABASE_URL=postgresql+psycopg://bennett:bennett_dev@localhost:5433/bennett_one

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me
